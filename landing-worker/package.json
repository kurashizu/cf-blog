{
    "name": "cf-landing",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
        "build:cf": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "prepare": "svelte-kit sync || echo ''",
        "deploy:cf": "wrangler deploy"
    },
    "dependencies": {
        "@mlc-ai/web-llm": "^0.2.84",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "mermaid": "^11.17.2",
        "v86": "^0.5.445"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250520.0",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@webgpu/types": "^0.1.72",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vite": "^8.0.16",
        "wrangler": "^4.86.0"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "workerd@1.20260825.1": true
    }
}
